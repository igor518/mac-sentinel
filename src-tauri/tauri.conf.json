{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "MacSentinel",
	"version": "0.1.0",
	"identifier": "com.macsentinel.app",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "MacSentinel",
				"width": 1200,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600,
				"visible": false
			}
		],
		"security": {
			"csp": null,
			"capabilities": ["default"]
		}
	},
	"bundle": {
		"active": true,
		"targets": ["dmg"],
		"icon": [],
		"macOS": {
			"minimumSystemVersion": "14.0"
		}
	}
}
