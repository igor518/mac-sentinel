{
	"name": "macsentinel",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e:build": "VITE_E2E_FIXTURES=true tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
		"test:e2e": "bun run test:e2e:build && wdio run ./wdio.conf.ts",
		"tauri": "tauri"
	},
	"dependencies": {
		"@tauri-apps/api": "2.12.4",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.4",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"@wdio/cli": "9.31.9",
		"@wdio/local-runner": "9.31.9",
		"@wdio/mocha-framework": "9.31.9",
		"@wdio/spec-reporter": "9.31.2",
		"@wdio/tauri-service": "1.5.1",
		"jsdom": "31.0.0",
		"typescript": "7.0.2",
		"vite": "8.3.6",
		"vitest": "5.1.0",
		"webdriverio": "9.31.9"
	}
}
